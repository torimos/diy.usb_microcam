[Unit]
Description=USB camera viewer
After=systemd-vconsole-setup.service

[Service]
Group=pi
StateDirectory=usb-microcam-native
ExecStart=/usr/local/bin/usb-microcam-native --touch /dev/input/by-id/usb-WaveShare_WaveShare_Touchscreen_2016-11-06-event-if00 --fixed-exposure-fps --idle 900 --settings-file /var/lib/usb-microcam-native/screen-timeout --screenshots /home/pi/diy.usb_microcam/screenshots
Restart=on-failure
RestartSec=3
# The viewer detaches the text console from the framebuffer while it runs and
# reattaches it on exit. Do it again if the viewer is killed before it can.
ExecStopPost=-/bin/sh -c 'for d in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" "$d/name" && [ "$(cat "$d/bind")" = 0 ] && echo 1 > "$d/bind"; done'

[Install]
WantedBy=multi-user.target
